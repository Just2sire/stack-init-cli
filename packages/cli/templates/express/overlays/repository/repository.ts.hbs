{{else if (eq expressConfig.orm "prisma")}}
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

export class {{pascalName}}Repository {
  async findAll() {
    return prisma.{{camelName}}.findMany();
  }

  async findById(id: {{#each fields}}{{#if (eq type "id")}}number{{/if}}{{#if (eq type "uuid")}}string{{/if}}{{/each}}) {
    return prisma.{{camelName}}.findUnique({ where: { id } });
  }

  async create(data: any) {
    return prisma.{{camelName}}.create({ data });
  }

  async update(id: {{#each fields}}{{#if (eq type "id")}}number{{/if}}{{#if (eq type "uuid")}}string{{/if}}{{/each}}, data: any) {
    return prisma.{{camelName}}.update({ where: { id }, data });
  }

  async delete(id: {{#each fields}}{{#if (eq type "id")}}number{{/if}}{{#if (eq type "uuid")}}string{{/if}}{{/each}}) {
    return prisma.{{camelName}}.delete({ where: { id } });
  }
}
{{else}}
export class {{pascalName}}Repository {
  private store: any[] = [];
  private nextId = 1;

  async findAll() { return this.store; }

  async findById(id: number) {
    return this.store.find(item => item.id === id) ?? null;
  }

  async create(data: any) {
    const item = { id: this.nextId++, ...data };
    this.store.push(item);
    return item;
  }

  async update(id: number, data: any) {
    const idx = this.store.findIndex(item => item.id === id);
    if (idx === -1) return null;
    this.store[idx] = { ...this.store[idx], ...data };
    return this.store[idx];
  }

  async delete(id: number) {
    this.store = this.store.filter(item => item.id !== id);
  }
}
