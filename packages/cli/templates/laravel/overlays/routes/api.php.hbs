<?php

use Illuminate\Support\Facades\Route;
{{#each models}}
{{#if generate.routes}}
use App\Http\Controllers\Api\\{{name}}Controller;
{{/if}}
{{/each}}
{{#if hasAuth}}
use App\Http\Controllers\AuthController;
{{/if}}

/*
|--------------------------------------------------------------------------
| API Routes
|--------------------------------------------------------------------------
*/

{{#if hasAuth}}
Route::prefix('{{apiVersion}}')->group(function () {
    Route::post('/register', [AuthController::class, 'register']);
    Route::post('/login', [AuthController::class, 'login']);
});

Route::middleware('auth:sanctum')->prefix('{{apiVersion}}')->group(function () {
    Route::post('/logout', [AuthController::class, 'logout']);

{{#each models}}
{{#if generate.routes}}
    Route::apiResource('{{routeName}}', {{name}}Controller::class);
{{/if}}
{{/each}}
    // @stack-init-routes-end
});
{{else}}
Route::prefix('{{apiVersion}}')->group(function () {
{{#each models}}
{{#if generate.routes}}
    Route::apiResource('{{routeName}}', {{name}}Controller::class);
{{/if}}
{{/each}}
    // @stack-init-routes-end
});
{{/if}}
