<?php
{{#if laravelOptions.use_strict_types}}

declare(strict_types=1);
{{/if}}

namespace Tests\Feature;

use App\Models\\{{name}};
{{#if hasAuth}}
{{#unless isUserModel}}
use App\Models\User;
{{/unless}}
{{/if}}
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class {{name}}Test extends TestCase
{
    use RefreshDatabase;

{{#if hasAuth}}
    private User $user;

    protected function setUp(): void
    {
        parent::setUp();

        $this->user = User::factory()->create();
        $this->actingAs($this->user);
    }

{{/if}}
    public function test_liste_les_{{routeName}}(): void
    {
        {{name}}::factory()->count(3)->create();

        $this->getJson('/{{laravelOptions.route_prefix}}/{{apiVersion}}/{{routeName}}')
            ->assertOk()
            ->assertJsonStructure(['success', 'data', 'meta']);
    }

    public function test_affiche_un_{{varName}}(): void
    {
        ${{varName}} = {{name}}::factory()->create();

        $this->getJson("/{{laravelOptions.route_prefix}}/{{apiVersion}}/{{routeName}}/{${{varName}}->id}")
            ->assertOk()
            ->assertJsonPath('data.id', ${{varName}}->id);
    }

    public function test_cree_un_{{varName}}(): void
    {
        $payload = {{name}}::factory()->make()->toArray();

        $this->postJson('/{{laravelOptions.route_prefix}}/{{apiVersion}}/{{routeName}}', $payload)
            ->assertCreated()
            ->assertJsonPath('success', true);

        $this->assertDatabaseHas('{{tableName}}', $payload);
    }

    public function test_refuse_la_creation_sans_donnees_requises(): void
    {
        $this->postJson('/{{laravelOptions.route_prefix}}/{{apiVersion}}/{{routeName}}', [])
            ->assertUnprocessable()
            ->assertJsonPath('success', false);
    }

    public function test_met_a_jour_un_{{varName}}(): void
    {
        ${{varName}} = {{name}}::factory()->create();
        $payload     = {{name}}::factory()->make()->toArray();

        $this->putJson("/{{laravelOptions.route_prefix}}/{{apiVersion}}/{{routeName}}/{${{varName}}->id}", $payload)
            ->assertOk()
            ->assertJsonPath('success', true);

        $this->assertDatabaseHas('{{tableName}}', ['id' => ${{varName}}->id, ...$payload]);
    }

    public function test_supprime_un_{{varName}}(): void
    {
        ${{varName}} = {{name}}::factory()->create();

        $this->deleteJson("/{{laravelOptions.route_prefix}}/{{apiVersion}}/{{routeName}}/{${{varName}}->id}")
            ->assertOk()
            ->assertJsonPath('success', true);

{{#if generate.softDelete}}
        $this->assertSoftDeleted('{{tableName}}', ['id' => ${{varName}}->id]);
{{else}}
        $this->assertDatabaseMissing('{{tableName}}', ['id' => ${{varName}}->id]);
{{/if}}
    }

    public function test_retourne_404_pour_un_{{varName}}_inexistant(): void
    {
        $this->getJson('/{{laravelOptions.route_prefix}}/{{apiVersion}}/{{routeName}}/id-inexistant')
            ->assertNotFound();
    }
}
