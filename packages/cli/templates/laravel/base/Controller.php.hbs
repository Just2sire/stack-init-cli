<?php
{{#if laravelOptions.use_strict_types}}

declare(strict_types=1);
{{/if}}

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\\{{name}};
{{#if generate.resource}}
use App\Http\Resources\\{{name}}Resource;
{{/if}}
{{#if generate.collection}}
use App\Http\Resources\\{{name}}Collection;
{{/if}}
{{#if generate.request}}
{{#if laravelOptions.use_feature_requests}}
use App\Http\Requests\\{{name}}\Store{{name}}Request;
use App\Http\Requests\\{{name}}\Update{{name}}Request;
{{else}}
use App\Http\Requests\Store{{name}}Request;
use App\Http\Requests\Update{{name}}Request;
{{/if}}
{{/if}}
{{#if generate.service}}
use App\Services\\{{name}}Service;
{{/if}}
{{#if laravelOptions.use_api_response}}
use App\Traits\ApiResponse;
{{/if}}
use Illuminate\Http\{JsonResponse, Request};
use OpenApi\Attributes as OA;

class {{name}}Controller extends Controller
{
{{#if laravelOptions.use_api_response}}
    use ApiResponse;

{{/if}}
{{#if generate.service}}
    public function __construct(
        private {{#if laravelOptions.use_readonly}}readonly {{/if}}{{name}}Service $service
    ) {}

{{/if}}
    {{#if generate.swagger}}
    #[OA\Get(
        path: "/{{laravelOptions.route_prefix}}/{{routeName}}",
        summary: "Get list of {{name}}",
        tags: ["{{name}}"],
        {{#if hasAuth}}{{{swaggerSecurity}}}{{/if}}
        parameters: [
            new OA\Parameter(name: "per_page", in: "query", required: false, schema: new OA\Schema(type: "integer", example: 15)),
        ],
        responses: [
            new OA\Response(response: 200, description: "Successful operation"),
            new OA\Response(response: 401, description: "Unauthenticated", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
        ]
    )]
    {{/if}}
    public function index(Request $request): JsonResponse
    {
{{#if laravelOptions.use_api_response}}
        return $this->try(function () use ($request) {
{{#if generate.service}}
            $paginator = $this->service->paginate($request);
{{else}}
            $paginator = {{name}}::query()->paginate($request->integer('per_page', 15));
{{/if}}
{{#if generate.resource}}
            return $this->paginated($paginator, {{name}}Resource::class);
{{else if generate.collection}}
            return $this->paginated($paginator, {{name}}Collection::class);
{{else if false}}
            return $this->paginated($paginator, {{name}}Resource::class);
{{else}}
            return $this->paginated($paginator);
{{/if}}
        });
{{else}}
{{#if generate.service}}
        $items = $this->service->paginate($request);
{{else}}
        $items = {{name}}::query()->paginate($request->integer('per_page', 15));
{{/if}}
{{#if generate.collection}}
        return (new {{name}}Collection($items))->response();
{{else if generate.resource}}
        return {{name}}Resource::collection($items)->response();
{{else}}
        return response()->json($items);
{{/if}}
{{/if}}
    }

    {{#if generate.swagger}}
    #[OA\Get(
        path: "/{{laravelOptions.route_prefix}}/{{routeName}}/{id}",
        summary: "Get {{name}} information",
        tags: ["{{name}}"],
        {{#if hasAuth}}{{{swaggerSecurity}}}{{/if}}
        parameters: [
            new OA\Parameter(name: "id", in: "path", required: true, schema: new OA\Schema(type: "{{idType}}")),
        ],
        responses: [
            new OA\Response(response: 200, description: "Successful operation"),
            new OA\Response(response: 404, description: "Not found", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
            new OA\Response(response: 401, description: "Unauthenticated", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
        ]
    )]
    {{/if}}
    public function show({{name}} ${{varName}}): JsonResponse
    {
{{#if laravelOptions.use_api_response}}
        return $this->try(function () use (${{varName}}) {
{{#if generate.resource}}
            return $this->success(new {{name}}Resource(${{varName}}));
{{else}}
            return $this->success(${{varName}});
{{/if}}
        });
{{else}}
{{#if generate.resource}}
        return (new {{name}}Resource(${{varName}}))->response();
{{else}}
        return response()->json(${{varName}});
{{/if}}
{{/if}}
    }

    {{#if generate.swagger}}
    #[OA\Post(
        path: "/{{laravelOptions.route_prefix}}/{{routeName}}",
        summary: "Store new {{name}}",
        tags: ["{{name}}"],
        {{#if hasAuth}}{{{swaggerSecurity}}}{{/if}}
        requestBody: new OA\RequestBody(
            required: true,
            content: new OA\JsonContent(
                properties: [
{{#each swaggerFields}}
                    new OA\Property(property: "{{name}}", type: "{{oaType}}"{{#if nullable}}, nullable: true{{/if}}),
{{/each}}
                ]
            )
        ),
        responses: [
            new OA\Response(response: 201, description: "Resource created"),
            new OA\Response(response: 422, description: "Validation error", content: new OA\JsonContent(ref: "#/components/schemas/ValidationErrorResponse")),
            new OA\Response(response: 401, description: "Unauthenticated", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
        ]
    )]
    {{/if}}
    public function store({{#if generate.request}}Store{{name}}Request{{else}}Request{{/if}} $request): JsonResponse
    {
{{#if laravelOptions.use_api_response}}
        return $this->try(function () use ($request) {
{{#if generate.service}}
            $item = $this->service->create($request->validated());
{{else}}
            $item = {{name}}::create($request->validated());
{{/if}}
{{#if generate.resource}}
            return $this->created(new {{name}}Resource($item));
{{else}}
            return $this->created($item);
{{/if}}
        });
{{else}}
{{#if generate.service}}
        $item = $this->service->create($request->validated());
{{else}}
        $item = {{name}}::create($request->validated());
{{/if}}
{{#if generate.resource}}
        return (new {{name}}Resource($item))->response()->setStatusCode(201);
{{else}}
        return response()->json($item, 201);
{{/if}}
{{/if}}
    }

    {{#if generate.swagger}}
    #[OA\Put(
        path: "/{{laravelOptions.route_prefix}}/{{routeName}}/{id}",
        summary: "Update existing {{name}}",
        tags: ["{{name}}"],
        {{#if hasAuth}}{{{swaggerSecurity}}}{{/if}}
        parameters: [
            new OA\Parameter(name: "id", in: "path", required: true, schema: new OA\Schema(type: "{{idType}}")),
        ],
        requestBody: new OA\RequestBody(
            required: true,
            content: new OA\JsonContent(
                properties: [
{{#each swaggerFields}}
                    new OA\Property(property: "{{name}}", type: "{{oaType}}"{{#if nullable}}, nullable: true{{/if}}),
{{/each}}
                ]
            )
        ),
        responses: [
            new OA\Response(response: 200, description: "Successful operation"),
            new OA\Response(response: 404, description: "Not found", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
            new OA\Response(response: 422, description: "Validation error", content: new OA\JsonContent(ref: "#/components/schemas/ValidationErrorResponse")),
            new OA\Response(response: 401, description: "Unauthenticated", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
        ]
    )]
    {{/if}}
    public function update({{#if generate.request}}Update{{name}}Request{{else}}Request{{/if}} $request, {{name}} ${{varName}}): JsonResponse
    {
{{#if laravelOptions.use_api_response}}
        return $this->try(function () use ($request, ${{varName}}) {
{{#if generate.service}}
            $item = $this->service->update(${{varName}}, $request->validated());
{{else}}
            ${{varName}}->update($request->validated());
            $item = ${{varName}}->fresh();
{{/if}}
{{#if generate.resource}}
            return $this->updated(new {{name}}Resource($item));
{{else}}
            return $this->updated($item);
{{/if}}
        });
{{else}}
{{#if generate.service}}
        $item = $this->service->update(${{varName}}, $request->validated());
{{else}}
        ${{varName}}->update($request->validated());
        $item = ${{varName}};
{{/if}}
{{#if generate.resource}}
        return (new {{name}}Resource($item))->response();
{{else}}
        return response()->json($item);
{{/if}}
{{/if}}
    }

    {{#if generate.swagger}}
    #[OA\Delete(
        path: "/{{laravelOptions.route_prefix}}/{{routeName}}/{id}",
        summary: "Delete {{name}}",
        tags: ["{{name}}"],
        {{#if hasAuth}}{{{swaggerSecurity}}}{{/if}}
        parameters: [
            new OA\Parameter(name: "id", in: "path", required: true, schema: new OA\Schema(type: "{{idType}}")),
        ],
        responses: [
            new OA\Response(response: 200, description: "Deleted successfully"),
            new OA\Response(response: 404, description: "Not found", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
            new OA\Response(response: 401, description: "Unauthenticated", content: new OA\JsonContent(ref: "#/components/schemas/ErrorResponse")),
        ]
    )]
    {{/if}}
    public function destroy({{name}} ${{varName}}): JsonResponse
    {
{{#if laravelOptions.use_api_response}}
        return $this->try(function () use (${{varName}}) {
{{#if generate.service}}
            $this->service->delete(${{varName}});
{{else}}
            ${{varName}}->delete();
{{/if}}
            return $this->deleted();
        });
{{else}}
{{#if generate.service}}
        $this->service->delete(${{varName}});
{{else}}
        ${{varName}}->delete();
{{/if}}
        return response()->json(null, 204);
{{/if}}
    }
}
