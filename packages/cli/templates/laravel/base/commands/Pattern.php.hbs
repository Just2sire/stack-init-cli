    private function mapTypeToMigrationColumn(string $field, string $type): string
    {
        return match (strtolower($type)) {
            'string'           => "\$table->string('{$field}')",
            'text'             => "\$table->text('{$field}')",
            'integer', 'int'   => "\$table->integer('{$field}')",
            'float'            => "\$table->float('{$field}')",
            'decimal'          => "\$table->decimal('{$field}', 10, 2)",
            'boolean', 'bool'  => "\$table->boolean('{$field}')->default(false)",
            'date'             => "\$table->date('{$field}')->nullable()",
            'datetime'         => "\$table->dateTime('{$field}')->nullable()",
            'json', 'array'    => "\$table->json('{$field}')->nullable()",
            'email'            => "\$table->string('{$field}')",
            default            => "\$table->string('{$field}')",
        };
    }

    private function generateFakerForField(string $field, string $type): string
    {
        $lower = strtolower($field);

        if (str_contains($lower, 'email'))                                  return 'fake()->safeEmail()';
        if (str_contains($lower, 'phone'))                                  return 'fake()->phoneNumber()';
        if (str_contains($lower, 'name'))                                   return 'fake()->name()';
        if (str_contains($lower, 'title'))                                  return 'fake()->sentence(3)';
        if (str_contains($lower, 'description') || str_contains($lower, 'note')) return 'fake()->paragraph()';
        if (str_contains($lower, 'url') || str_contains($lower, 'link'))   return 'fake()->url()';

        return match (strtolower($type)) {
            'string'            => 'fake()->word()',
            'text'              => 'fake()->paragraph()',
            'integer', 'int'    => 'fake()->randomNumber()',
            'float', 'decimal'  => 'fake()->randomFloat(2, 0, 1000)',
            'boolean', 'bool'   => 'fake()->boolean()',
            'date'              => 'fake()->date()',
            'datetime'          => "fake()->dateTime()->format('Y-m-d H:i:s')",
            'email'             => 'fake()->safeEmail()',
            'json', 'array'     => '[]',
            default             => 'fake()->word()',
        };
    }

    private function mapTypeToCast(string $type): ?string
    {
        return match (strtolower($type)) {
            'integer', 'int'           => 'integer',
            'float', 'decimal'         => 'float',
            'boolean', 'bool'          => 'boolean',
            'date'                     => 'date',
            'datetime'                 => 'datetime',
            'json', 'array'            => 'array',
            default                    => null,
        };
    }

    private function mapTypeToValidation(string $type): string
    {
        return match (strtolower($type)) {
            'string', 'text'           => "string', 'max:255",
            'integer', 'int'           => 'integer',
            'float', 'decimal'         => 'numeric',
            'boolean', 'bool'          => 'boolean',
            'date', 'datetime'         => 'date',
            'email'                    => 'email',
            default                    => 'string',
        };
    }
