  deletedAt: Date;
  {{/if}}

  {{#each relations}}
  {{#if (eq type "belongsTo")}}
  @ManyToOne(() => {{pascalCase model}}, ({{camelCase model}}) => {{camelCase model}}.{{camelCasePlural ../name}})
  {{camelCase model}}: any;
  {{/if}}
  {{#if (eq type "hasMany")}}
  @OneToMany(() => {{pascalCase model}}, ({{camelCase model}}) => {{camelCase model}}.{{camelCase ../name}})
  {{camelCasePlural model}}: any[];
  {{/if}}
  {{/each}}
}
