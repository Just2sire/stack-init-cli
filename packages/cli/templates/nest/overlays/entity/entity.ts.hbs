{{#if (eq nestConfig.orm "typeorm")}}
import { Entity, PrimaryGeneratedColumn, Column, CreateDateColumn, UpdateDateColumn, DeleteDateColumn{{#if relations}}, ManyToOne, OneToMany{{/if}} } from 'typeorm';

@Entity('{{tableName}}')
export class {{pascalName}} {
  {{#each fields}}
  {{#if (eq type "id")}}
  @PrimaryGeneratedColumn()
  id: number;
  {{else if (eq type "uuid")}}
  @PrimaryGeneratedColumn('uuid')
  id: string;
  {{else}}
  @Column({
    name: '{{name}}',
    type: '{{#if (eq tsType "number")}}int{{else if (eq tsType "boolean")}}boolean{{else}}varchar{{/if}}',
    nullable: {{#if nullable}}true{{else}}false{{/if}},
    {{#if unique}}unique: true,{{/if}}
  })
