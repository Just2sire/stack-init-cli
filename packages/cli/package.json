{
  "name": "stack-init-cli",
  "version": "0.2.2",
  "description": "Scaffold models, migrations, controllers and more for Laravel, Express, NestJS, FastAPI and Next.js from a single YAML file",
  "author": "Kossi Désiré Komla <kossidesirekomla@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Just2sire/stack-init-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Just2sire/stack-init-cli#readme",
  "bugs": {
    "url": "https://github.com/Just2sire/stack-init-cli/issues"
  },
  "keywords": [
    "scaffold",
    "scaffolder",
    "codegen",
    "code-generator",
    "cli",
    "yaml",
    "laravel",
    "express",
    "nestjs",
    "fastapi",
    "nextjs",
    "react",
    "migrations",
    "models",
    "boilerplate",
    "typescript",
    "generator",
    "backend",
    "fullstack",
    "monorepo"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "stack-init": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "commander": "^12.0.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
