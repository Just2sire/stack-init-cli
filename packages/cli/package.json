{
  "name": "stack-init-cli",
  "version": "0.1.5",
  "bin": {
    "stack-init-cli": "./dist/index.js"
  },
  "description": "Scaffold models, migrations, controllers and more for Laravel, Express, NestJS, FastAPI and Next.js from a single YAML file",
  "keywords": [
    "scaffold",
    "scaffolder",
    "codegen",
    "code-generator",
    "cli",
    "yaml",
    "laravel",
    "express",
    "nestjs",
    "fastapi",
    "nextjs",
    "react",
    "migrations",
    "models",
    "boilerplate",
    "typescript",
    "generator",
    "backend",
    "fullstack",
    "monorepo"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "commander": "^12.0.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "picocolors": "^1.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
